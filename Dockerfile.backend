# --- 第一阶段：构建阶段 (Build Stage) ---
# 使用官方 Java 21 镜像，这比手动在 ubuntu 运行 apt-get 更快、更稳
FROM eclipse-temurin:21-jdk-jammy AS build

# 设置工作目录
WORKDIR /app

# 复制 Maven 核心文件（包含隐藏的 .mvn 目录）
COPY backend/hotel/mvnw* backend/hotel/pom.xml ./
COPY backend/hotel/.mvn ./.mvn

# 赋予 mvnw 执行权限
RUN chmod +x mvnw

# 下载依赖（利用 Docker 缓存，这一步可能需要几分钟）
RUN ./mvnw dependency:go-offline -B

# 复制源代码并构建项目
COPY backend/hotel/src ./src
RUN ./mvnw clean package -DskipTests

# --- 第二阶段：运行阶段 (Runtime Stage) ---
# 运行环境只需要 JRE，镜像体积会更小
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app

# 从构建阶段复制生成的 jar 包
COPY --from=build /app/target/*.jar app.jar

# 暴露后端端口（根据你的项目配置，通常是 8082 或 8080）
EXPOSE 8082

# 启动命令
ENTRYPOINT ["java", "-jar", "app.jar"]
